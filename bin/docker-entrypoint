#!/bin/bash
set -e

# Remove preexisting master.key if any
rm -f tmp/pids/server.pid

# Wait for PostgreSQL to be ready
if [ -n "$DATABASE_HOST" ]; then
  echo "Waiting for database at $DATABASE_HOST..."
  while ! nc -z "$DATABASE_HOST" "${DATABASE_PORT:-5432}" 2>/dev/null; do
    sleep 0.1
  done
  echo "Database is ready!"
fi

# Run migrations
if [ "$SKIP_DB_MIGRATE" != "true" ]; then
  echo "Running database migrations..."
  bundle exec rails db:migrate
else
  echo "Skipping database migrations (SKIP_DB_MIGRATE is true)"
fi

# Execute the passed command
exec "$@"
