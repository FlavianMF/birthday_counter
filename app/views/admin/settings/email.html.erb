<div class="max-w-4xl mx-auto py-10">
  <h1 class="text-3xl font-bold mb-6">Configuração de Serviço de Email</h1>

  <%= form_with url: admin_update_email_settings_path, method: :post, local: true, class: "space-y-6 bg-slate-900 p-8 rounded-lg border border-slate-800" do |f| %>
    <div>
      <%= f.label "config[smtp_address]", "Endereço SMTP", class: "block text-sm font-medium text-slate-300" %>
      <%= f.text_field "config[smtp_address]", value: @config['smtp_address'], class: "mt-1 block w-full rounded-md border-slate-700 bg-slate-800 text-white shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
      <p class="mt-2 text-xs text-slate-500">Ex: mailpit, smtp.gmail.com, etc.</p>
    </div>

    <div>
      <%= f.label "config[smtp_port]", "Porta SMTP", class: "block text-sm font-medium text-slate-300" %>
      <%= f.number_field "config[smtp_port]", value: @config['smtp_port'], class: "mt-1 block w-full rounded-md border-slate-700 bg-slate-800 text-white shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>

    <div>
      <%= f.label "config[smtp_domain]", "Domínio SMTP", class: "block text-sm font-medium text-slate-300" %>
      <%= f.text_field "config[smtp_domain]", value: @config['smtp_domain'], placeholder: "localhost", class: "mt-1 block w-full rounded-md border-slate-700 bg-slate-800 text-white shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= f.label "config[smtp_user_name]", "Usuário SMTP", class: "block text-sm font-medium text-slate-300" %>
        <%= f.text_field "config[smtp_user_name]", value: @config['smtp_user_name'], class: "mt-1 block w-full rounded-md border-slate-700 bg-slate-800 text-white shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
      </div>

      <div>
        <%= f.label "config[smtp_password]", "Senha SMTP", class: "block text-sm font-medium text-slate-300" %>
        <%= f.password_field "config[smtp_password]", value: @config['smtp_password'], class: "mt-1 block w-full rounded-md border-slate-700 bg-slate-800 text-white shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= f.label "config[smtp_authentication]", "Autenticação", class: "block text-sm font-medium text-slate-300" %>
        <%= f.select "config[smtp_authentication]", options_for_select([['Nenhuma', ''], ['Plain', 'plain'], ['Login', 'login'], ['Cram MD5', 'cram_md5']], @config['smtp_authentication']), {}, class: "mt-1 block w-full rounded-md border-slate-700 bg-slate-800 text-white shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
      </div>

      <div class="flex items-center pt-6">
        <%= f.check_box "config[smtp_enable_starttls_auto]", { checked: @config['smtp_enable_starttls_auto'] == '1' || @config['smtp_enable_starttls_auto'] == true, class: "h-4 w-4 rounded border-slate-700 bg-slate-800 text-indigo-600 focus:ring-indigo-500" } %>
        <%= f.label "config[smtp_enable_starttls_auto]", "Habilitar StartTLS Auto", class: "ml-2 block text-sm text-slate-300" %>
      </div>
    </div>

    <div>
      <%= f.label "config[from_email]", "Email do Remetente (FROM)", class: "block text-sm font-medium text-slate-300" %>
      <%= f.email_field "config[from_email]", value: @config['from_email'], class: "mt-1 block w-full rounded-md border-slate-700 bg-slate-800 text-white shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>

    <div class="pt-4">
      <%= f.submit "Salvar Configurações", class: "w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
    </div>
  <% end %>

  <div class="mt-10 p-4 bg-slate-800 rounded border border-slate-700">
    <h2 class="text-lg font-semibold mb-2">Serviço de Teste (Mailpit)</h2>
    <p class="text-sm text-slate-400 mb-4">Em ambiente de desenvolvimento, você pode visualizar os emails enviados no Mailpit Web UI:</p>
    <a href="http://localhost:8025" target="_blank" class="text-indigo-400 hover:text-indigo-300 underline">Acessar Mailpit (localhost:8025)</a>
  </div>
</div>
