<!DOCTYPE html>
<html class="h-full bg-background">
  <head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= content_for(:title) || "Birthday Counter - Transforme a espera pela festa" %></title>
  <meta name="description" content="Transforme a espera pelo aniversário na própria festa. Jogos, rankings e cápsulas do tempo.">
  <%= csrf_meta_tags %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  
  <!-- Preconnect to Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  
  <!-- PWA Meta Tags -->
  <meta name="theme-color" content="#0F172A">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  </head>

  <body class="h-full overflow-x-hidden selection:bg-primary/30 selection:text-white" data-controller="celebration">
  <!-- Background effects container -->
  <div class="fixed inset-0 overflow-hidden pointer-events-none z-0">
    <!-- Subtle noise texture -->
    <div class="absolute inset-0 opacity-[0.03] mix-blend-overlay" style="background-image: url('https://grainy-gradients.vercel.app/noise.svg');"></div>
    
    <!-- Animated background gradient blobs -->
    <div class="absolute -top-40 -right-40 w-[500px] h-[500px] bg-primary/20 rounded-full blur-[120px] animate-blob"></div>
    <div class="absolute -bottom-40 -left-40 w-[500px] h-[500px] bg-fuchsia/20 rounded-full blur-[120px] animate-blob animation-delay-2000"></div>
    <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-cyan/10 rounded-full blur-[150px] animate-blob animation-delay-4000"></div>
    
    <!-- Extra accent blobs for depth -->
    <div class="absolute top-1/4 right-1/4 w-32 h-32 bg-amber-500/10 rounded-full blur-3xl animate-pulse"></div>
    <div class="absolute bottom-1/4 left-1/4 w-48 h-48 bg-rose-500/10 rounded-full blur-3xl animate-pulse animation-delay-2000"></div>
  </div>
  
  <div class="relative min-h-full z-10 flex flex-col">
    <%= render "shared/flash_messages" %>
    <main class="flex-grow">
      <%= yield %>
    </main>
    <div class="h-20 md:h-0"></div> <!-- Spacer for mobile nav -->
  </div>
  
  <!-- Bottom Navigation -->
  <%= render "shared/bottom_nav" %>
  </body>
</html>
