<div class="min-h-screen flex items-center justify-center p-4">
  <div class="w-full max-w-md">
    <!-- Back button -->
    <div class="mb-6">
      <%= link_to root_path, class: "flex items-center gap-2 text-white/70 hover:text-white transition-colors" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        <span>Voltar</span>
      <% end %>
    </div>

    <!-- Login Card -->
    <div class="glass-card p-8">
      <div class="text-center mb-8">
        <div class="w-16 h-16 mx-auto mb-4 bg-gradient-primary rounded-2xl flex items-center justify-center">
          <span class="text-3xl">🎂</span>
        </div>
        <h1 class="text-2xl font-bold text-gradient">Entrar</h1>
        <p class="text-white/60 mt-2">Acesse sua conta para continuar</p>
      </div>

      <%= form_with url: login_path, method: :post, class: "space-y-4" do |form| %>
        <div>
          <%= label_tag :email, "Email", class: "block text-sm font-medium text-white/70 mb-2" %>
          <%= email_field_tag :email, params[:email], 
              required: true,
              autocomplete: "email",
              class: "input-glass",
              placeholder: "seu@email.com" %>
        </div>

        <div>
          <%= label_tag :password, "Senha", class: "block text-sm font-medium text-white/70 mb-2" %>
          <%= password_field_tag :password, nil,
              required: true,
              autocomplete: "current-password",
              class: "input-glass",
              placeholder: "••••••••" %>
        </div>

        <%= form.submit "Entrar", class: "btn-primary w-full cursor-pointer mt-6" %>
      <% end %>

      <div class="mt-6 text-center">
        <p class="text-white/60 text-sm">
          Não tem uma conta?
          <%= link_to "Criar conta", register_path, class: "text-primary hover:underline" %>
        </p>
      </div>
    </div>
  </div>
</div>
