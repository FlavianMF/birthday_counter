<div class="min-h-screen flex items-center justify-center p-4 bg-gradient-to-br from-background via-background to-surface/50 relative">
  <!-- Animated background elements -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute top-20 left-10 w-72 h-72 bg-primary/10 rounded-full blur-3xl animate-float"></div>
    <div class="absolute bottom-20 right-10 w-96 h-96 bg-fuchsia/10 rounded-full blur-3xl animate-float-delayed"></div>
  </div>

  <div class="w-full max-w-md relative z-10">
    <!-- Back button with improved styling -->
    <div class="mb-6 animate-fade-in">
      <%= link_to root_path, class: "group inline-flex items-center gap-2 text-white/60 hover:text-white transition-all duration-200 hover:gap-3" do %>
        <svg class="w-5 h-5 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        <span class="font-medium">Voltar</span>
      <% end %>
    </div>

    <!-- Register Card with enhanced glassmorphism -->
    <div class="relative animate-scale-in">
      <!-- Glow effect behind card -->
      <div class="absolute -inset-1 bg-gradient-to-r from-violet-600 to-fuchsia-600 rounded-3xl blur opacity-30 animate-pulse"></div>
      
      <div class="relative glass-card p-8">
        <!-- Header with logo -->
        <div class="text-center mb-8">
          <!-- Animated logo -->
          <div class="relative w-20 h-20 mx-auto mb-4">
            <div class="absolute inset-0 bg-gradient-to-br from-violet-500 to-fuchsia-500 rounded-2xl blur-lg opacity-50 animate-pulse"></div>
            <div class="relative w-full h-full bg-gradient-to-br from-violet-500 to-fuchsia-500 rounded-2xl flex items-center justify-center shadow-lg shadow-primary/50 transform hover:scale-110 transition-transform duration-300">
              <span class="text-4xl">🎂</span>
            </div>
          </div>
          <h1 class="text-3xl font-bold bg-gradient-to-r from-violet-400 to-fuchsia-400 bg-clip-text text-transparent mb-2">
            Criar Conta
          </h1>
          <p class="text-white/60 text-sm">
            Comece a planejar sua celebração
          </p>
        </div>

        <!-- Registration Form -->
        <%= form_with model: @user, url: register_path, method: :post, local: true, class: "space-y-5" do |form| %>
          <div class="space-y-1">
            <%= form.label :name, "Nome completo", class: "block text-sm font-medium text-white/80" %>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <svg class="w-5 h-5 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                </svg>
              </div>
              <%= form.text_field :name, 
                required: true,
                autocomplete: "name",
                class: "input-glass pl-10 transition-all duration-200 focus:scale-[1.02]",
                placeholder: "Seu nome completo" %>
            </div>
          </div>

          <div class="space-y-1">
            <%= form.label :email, "Email", class: "block text-sm font-medium text-white/80" %>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <svg class="w-5 h-5 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207"></path>
                </svg>
              </div>
              <%= form.email_field :email, 
                required: true,
                autocomplete: "email",
                class: "input-glass pl-10 transition-all duration-200 focus:scale-[1.02]",
                placeholder: "seu@email.com" %>
            </div>
          </div>

          <div class="space-y-1">
            <%= form.label :password, "Senha", class: "block text-sm font-medium text-white/80" %>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <svg class="w-5 h-5 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                </svg>
              </div>
              <%= form.password_field :password,
                required: true,
                minlength: 6,
                autocomplete: "new-password",
                class: "input-glass pl-10 transition-all duration-200 focus:scale-[1.02]",
                placeholder: "Mínimo 6 caracteres" %>
            </div>
          </div>

          <div class="space-y-1">
            <%= form.label :password_confirmation, "Confirmar senha", class: "block text-sm font-medium text-white/80" %>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <svg class="w-5 h-5 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <%= form.password_field :password_confirmation,
                required: true,
                minlength: 6,
                autocomplete: "new-password",
                class: "input-glass pl-10 transition-all duration-200 focus:scale-[1.02]",
                placeholder: "Repita a senha" %>
            </div>
          </div>

          <%= form.submit "Criar Conta", class: "btn-primary w-full cursor-pointer mt-6 transform hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 shadow-lg hover:shadow-xl hover:shadow-primary/30" %>
        <% end %>

        <!-- Login link -->
        <div class="mt-8 text-center pt-6 border-t border-white/10">
          <p class="text-white/60 text-sm">
            Já tem uma conta?
            <%= link_to "Fazer login", login_path, class: "text-primary hover:text-primary/80 font-medium transition-colors ml-1" %>
          </p>
        </div>
      </div>
    </div>

    <!-- Features section -->
    <div class="mt-8 grid grid-cols-3 gap-4 text-center animate-fade-in" style="animation-delay: 200ms">
      <div class="text-white/40 text-xs">
        <div class="text-2xl mb-1 animate-float">🎮</div>
        <div>Jogos</div>
      </div>
      <div class="text-white/40 text-xs">
        <div class="text-2xl mb-1 animate-float" style="animation-delay: 0.5s">🏆</div>
        <div>Ranking</div>
      </div>
      <div class="text-white/40 text-xs">
        <div class="text-2xl mb-1 animate-float" style="animation-delay: 1s">🎉</div>
        <div>Comemore</div>
      </div>
    </div>
  </div>
</div>
