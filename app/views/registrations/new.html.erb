<div class="min-h-screen flex items-center justify-center p-4">
  <div class="w-full max-w-md">
    <!-- Back button -->
    <div class="mb-6">
      <%= link_to root_path, class: "flex items-center gap-2 text-white/70 hover:text-white transition-colors" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        <span>Voltar</span>
      <% end %>
    </div>

    <!-- Register Card -->
    <div class="glass-card p-8">
      <div class="text-center mb-8">
        <div class="w-16 h-16 mx-auto mb-4 bg-gradient-primary rounded-2xl flex items-center justify-center">
          <span class="text-3xl">🎂</span>
        </div>
        <h1 class="text-2xl font-bold text-gradient">Criar Conta</h1>
        <p class="text-white/60 mt-2">Comece a planejar sua celebração</p>
      </div>

      <%= form_with model: User.new, url: register_path, method: :post, local: true, class: "space-y-4" do |form| %>
        <div>
          <%= form.label :name, "Nome", class: "block text-sm font-medium text-white/70 mb-2" %>
          <%= form.text_field :name, 
              required: true,
              autocomplete: "name",
              class: "input-glass",
              placeholder: "Seu nome completo" %>
        </div>

        <div>
          <%= form.label :email, "Email", class: "block text-sm font-medium text-white/70 mb-2" %>
          <%= form.email_field :email, 
              required: true,
              autocomplete: "email",
              class: "input-glass",
              placeholder: "seu@email.com" %>
        </div>

        <div>
          <%= form.label :password, "Senha", class: "block text-sm font-medium text-white/70 mb-2" %>
          <%= form.password_field :password,
              required: true,
              minlength: 6,
              autocomplete: "new-password",
              class: "input-glass",
              placeholder: "Mínimo 6 caracteres" %>
        </div>

        <div>
          <%= form.label :password_confirmation, "Confirmar Senha", class: "block text-sm font-medium text-white/70 mb-2" %>
          <%= form.password_field :password_confirmation,
              required: true,
              minlength: 6,
              autocomplete: "new-password",
              class: "input-glass",
              placeholder: "Repita a senha" %>
        </div>

        <%= form.submit "Criar Conta", class: "btn-primary w-full cursor-pointer mt-6" %>
      <% end %>

      <div class="mt-6 text-center">
        <p class="text-white/60 text-sm">
          Já tem uma conta?
          <%= link_to "Fazer login", login_path, class: "text-primary hover:underline" %>
        </p>
      </div>
    </div>
  </div>
</div>
