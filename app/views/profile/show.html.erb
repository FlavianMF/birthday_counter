<div class="container-mobile py-8">
  <h1 class="text-3xl font-bold text-gradient mb-6">Meu Perfil</h1>
  
  <div class="glass-card p-6">
    <div class="text-center mb-6">
      <div class="w-24 h-24 mx-auto mb-4 bg-gradient-primary rounded-full flex items-center justify-center">
        <span class="text-4xl">👤</span>
      </div>
      <h2 class="text-2xl font-bold"><%= current_user&.name || "Visitante" %></h2>
      <p class="text-white/60"><%= current_user&.email %></p>
    </div>
    
    <div class="border-t border-white/10 pt-6">
      <div class="flex justify-between items-center mb-4">
        <span class="text-white/70">Coins</span>
        <span class="text-secondary font-bold">0 💰</span>
      </div>
      
      <div class="flex justify-between items-center mb-4">
        <span class="text-white/70">Pontuação Total</span>
        <span class="text-primary font-bold">0</span>
      </div>
    </div>
  </div>
</div>
