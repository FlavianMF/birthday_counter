<div class="container-mobile py-8 relative z-10" 
     data-controller="user-stats" 
     data-user-stats-user-id-value="<%= current_user&.id %>">
  <!-- Page Header -->
  <div class="animate-fade-in mb-6">
    <h1 class="text-3xl md:text-4xl font-bold bg-gradient-to-r from-violet-400 to-fuchsia-400 bg-clip-text text-transparent mb-2">
      Meu Perfil
    </h1>
    <p class="text-white/60 text-sm">Gerencie sua conta e progresso</p>
  </div>
  
  <!-- Profile Card -->
  <div class="glass-card p-6 mb-6 animate-scale-in">
    <!-- Avatar Section -->
    <div class="text-center mb-6">
      <div class="relative w-24 h-24 mx-auto mb-4">
        <!-- Animated glow behind avatar -->
        <div class="absolute inset-0 bg-gradient-to-r from-violet-600 to-fuchsia-600 rounded-full blur-xl opacity-50 animate-pulse"></div>
        
        <!-- Avatar container -->
        <div class="relative w-full h-full bg-gradient-to-br from-violet-500 to-fuchsia-500 rounded-full flex items-center justify-center shadow-lg shadow-primary/50 transform hover:scale-110 transition-all duration-300">
          <span class="text-4xl">👤</span>
        </div>
        
        <!-- Online indicator -->
        <div class="absolute bottom-1 right-1 w-5 h-5 bg-success border-2 border-background rounded-full"></div>
      </div>
      
      <h2 class="text-2xl font-bold text-white/90 mb-1"><%= current_user&.name || "Visitante" %></h2>
      <p class="text-white/60 text-sm"><%= current_user&.email %></p>
      
      <!-- Level badge -->
      <div class="inline-flex items-center gap-2 mt-3 px-4 py-1.5 bg-primary/20 rounded-full border border-primary/30">
        <span class="text-xs font-semibold text-primary" data-user-stats-target="level">Nível <%= current_user.level %></span>
      </div>
    </div>
    
    <!-- Stats Grid -->
    <div class="grid grid-cols-2 gap-4 mb-6">
      <div class="stat-card">
        <div class="flex items-center justify-center gap-2 mb-2">
          <span class="text-2xl">💰</span>
        </div>
        <div class="text-2xl font-bold text-secondary" data-user-stats-target="coins"><%= number_with_delimiter(current_user_coins) %></div>
        <div class="text-xs text-white/60 uppercase">Coins</div>
      </div>
      
      <div class="stat-card">
        <div class="flex items-center justify-center gap-2 mb-2">
          <span class="text-2xl">🎯</span>
        </div>
        <div class="text-2xl font-bold text-primary" data-user-stats-target="totalScore"><%= number_with_delimiter(current_user_total_score) %></div>
        <div class="text-xs text-white/60 uppercase">Pontuação Total</div>
      </div>
    </div>
    
    <!-- Progress to next level -->
    <div class="mb-6">
      <div class="flex justify-between text-xs text-white/60 mb-2">
        <span data-user-stats-target="level">Progresso Nível <%= current_user.level %></span>
        <span><span data-user-stats-target="totalScore"><%= current_user.total_score %></span> / <%= current_user.points_for_level(current_user.level + 1) %></span>
      </div>
      <div class="w-full bg-white/10 rounded-full h-3 overflow-hidden">
        <div class="bg-gradient-to-r from-violet-500 via-fuchsia-500 to-pink-500 h-full rounded-full transition-all duration-500" 
             data-user-stats-target="progress"
             style="width: <%= current_user.level_progress_percentage %>%"></div>
      </div>
      <div class="text-xs text-white/60 mt-2 text-center">Faltam <%= current_user.points_to_next_level %> pontos para o próximo nível</div>
    </div>
    
    <!-- Settings Links -->
    <div class="space-y-2">
      <a href="#" class="flex items-center justify-between p-3 rounded-xl hover:bg-white/5 transition-colors group">
        <div class="flex items-center gap-3">
          <svg class="w-5 h-5 text-white/60 group-hover:text-primary transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
          <span class="text-white/80">Configurações</span>
        </div>
        <svg class="w-4 h-4 text-white/40 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
      
      <a href="#" class="flex items-center justify-between p-3 rounded-xl hover:bg-white/5 transition-colors group">
        <div class="flex items-center gap-3">
          <svg class="w-5 h-5 text-white/60 group-hover:text-primary transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
          </svg>
          <span class="text-white/80">Sair</span>
        </div>
        <svg class="w-4 h-4 text-white/40 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </div>
  
  <!-- Achievements Preview -->
  <div class="glass-card p-6 animate-fade-in" style="animation-delay: 200ms">
    <h3 class="font-bold text-white/90 mb-4">Conquistas</h3>
    <div class="grid grid-cols-4 gap-3">
      <div class="aspect-square rounded-xl bg-gradient-to-br from-yellow-500/20 to-amber-500/20 flex items-center justify-center text-2xl border border-yellow-500/30">
        🏆
      </div>
      <div class="aspect-square rounded-xl bg-gradient-to-br from-cyan-500/20 to-blue-500/20 flex items-center justify-center text-2xl border border-cyan-500/30">
        🎯
      </div>
      <div class="aspect-square rounded-xl bg-gradient-to-br from-fuchsia-500/20 to-pink-500/20 flex items-center justify-center text-2xl border border-fuchsia-500/30">
        ⭐
      </div>
      <div class="aspect-square rounded-xl bg-white/5 flex items-center justify-center text-2xl border border-white/10 opacity-50">
        🔒
      </div>
    </div>
  </div>
</div>
