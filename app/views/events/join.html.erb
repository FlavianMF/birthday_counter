<div class="container-mobile py-8">
  <div class="animate-fade-in mb-8 text-center">
    <div class="text-5xl mb-4">🎁</div>
    <h1 class="text-3xl font-bold bg-gradient-to-r from-violet-400 to-fuchsia-400 bg-clip-text text-transparent mb-2">
      Você foi convidado!
    </h1>
    <p class="text-white/70">Você está prestes a entrar no evento:</p>
  </div>

  <div class="glass-card p-8 animate-fade-in text-center" style="animation-delay: 100ms">
    <h2 class="text-2xl font-bold text-white mb-2"><%= @event.name %></h2>
    <p class="text-white/60 mb-8"><%= @event.description %></p>

    <div class="flex items-center justify-center gap-3 p-4 bg-white/5 rounded-xl border border-white/10 mb-8">
      <div class="w-10 h-10 rounded-full bg-primary/20 flex items-center justify-center text-primary">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
        </svg>
      </div>
      <div class="text-left">
        <div class="text-xs text-white/40 uppercase">Anfitrião</div>
        <div class="text-white font-medium"><%= @event.host.name %></div>
      </div>
    </div>

    <%= button_to "Confirmar Participação", join_event_path(@event), method: :post, class: "btn-primary w-full py-4 text-lg mb-4" %>
    
    <%= link_to "Voltar", events_path, class: "block text-white/50 hover:text-white transition-colors" %>
  </div>
</div>
