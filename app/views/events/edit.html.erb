<div class="container-mobile py-8 relative z-10">
  <!-- Page Header -->
  <div class="animate-fade-in mb-6">
    <h1 class="text-3xl md:text-4xl font-bold bg-gradient-to-r from-violet-400 to-fuchsia-400 bg-clip-text text-transparent mb-2">
      Editar Evento
    </h1>
    <p class="text-white/60 text-sm">Atualize os detalhes da celebração</p>
  </div>
  
  <!-- Form Card -->
  <div class="glass-card p-6 animate-scale-in">
    <%= form_with model: @event, local: true, class: "space-y-6" do |form| %>
      <!-- Event Name -->
      <div class="space-y-2">
        <%= form.label :name, "Nome do Evento", class: "block text-sm font-medium text-white/80" %>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <svg class="w-5 h-5 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path>
            </svg>
          </div>
          <%= form.text_field :name, 
            required: true,
            class: "input-glass pl-10 transition-all duration-200 focus:scale-[1.01]",
            placeholder: "Aniversário do João" %>
        </div>
      </div>

      <!-- Description -->
      <div class="space-y-2">
        <%= form.label :description, "Descrição", class: "block text-sm font-medium text-white/80" %>
        <div class="relative">
          <div class="absolute top-3 left-3 pointer-events-none">
            <svg class="w-5 h-5 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
            </svg>
          </div>
          <%= form.text_area :description, 
            rows: 3,
            class: "input-glass pl-10 transition-all duration-200 focus:scale-[1.01]",
            placeholder: "Descreva seu evento..." %>
        </div>
      </div>

      <!-- Target Date -->
      <div class="space-y-2">
        <%= form.label :target_date, "Data do Aniversário", class: "block text-sm font-medium text-white/80" %>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <svg class="w-5 h-5 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
          </div>
          <%= form.datetime_select :target_date, 
            class: "input-glass pl-10 w-full transition-all duration-200 focus:scale-[1.01]" %>
        </div>
      </div>

      <!-- Is Surprise Checkbox -->
      <div class="space-y-4">
        <div class="relative flex items-center gap-3 p-4 bg-white/5 rounded-xl border border-white/10 hover:border-primary/30 transition-colors">
          <%= form.check_box :is_surprise, class: "w-5 h-5 rounded border-white/30 text-primary focus:ring-primary/50" %>
          <div class="flex-1">
            <label class="flex items-center gap-2 cursor-pointer">
              <span class="text-white/80 font-medium">É uma surpresa?</span>
              <span class="text-2xl">🎉</span>
            </label>
            <p class="text-xs text-white/50 mt-1">O aniversariante precisará reivindicar o evento via link</p>
          </div>
        </div>

        <div class="space-y-2 animate-fade-in">
          <%= form.label :recipient_email, "Email do Aniversariante (Opcional)", class: "block text-sm font-medium text-white/80" %>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
              <svg class="w-5 h-5 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
            </div>
            <%= form.email_field :recipient_email, 
              class: "input-glass pl-10 transition-all duration-200 focus:scale-[1.01]",
              placeholder: "email@aniversariante.com" %>
          </div>
        </div>
      </div>

      <!-- Submit Buttons -->
      <div class="flex gap-4 pt-4">
        <%= form.submit "Atualizar Evento", class: "btn-primary flex-1 cursor-pointer transform hover:scale-[1.02] active:scale-[0.98] transition-all duration-200" %>
        <%= link_to "Voltar", event_path(@event), class: "btn-secondary flex-1 text-center" %>
      </div>
    <% end %>
  </div>
</div>
