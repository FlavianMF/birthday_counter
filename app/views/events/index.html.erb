<div class="container-mobile py-8">
  <h1 class="text-3xl font-bold text-gradient mb-6">Meus Eventos</h1>
  
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    <% @events.each do |event| %>
      <div class="glass-card p-6">
        <h3 class="text-xl font-bold mb-2"><%= event.name %></h3>
        <p class="text-white/60 text-sm mb-4"><%= event.description %></p>
        <%= link_to event, class: "btn-primary block text-center" do %>
          Ver Detalhes
        <% end %>
      </div>
    <% end %>
  </div>
  
  <div class="mt-6">
    <%= link_to new_event_path, class: "btn-primary" do %>
      Novo Evento
    <% end %>
  </div>
</div>
