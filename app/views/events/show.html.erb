<div class="container-mobile py-8 relative z-10">
  <!-- Page Header -->
  <div class="animate-fade-in mb-6">
    <h1 class="text-3xl md:text-4xl font-bold bg-gradient-to-r from-violet-400 to-fuchsia-400 bg-clip-text text-transparent mb-2">
      <%= @event.name %>
    </h1>
    <p class="text-white/70"><%= @event.description %></p>
  </div>
  
  <!-- Event Details Card -->
  <div class="glass-card p-6 mb-6 animate-fade-in" style="animation-delay: 100ms">
    <!-- Event Status -->
    <div class="flex items-center gap-3 mb-6">
      <span class="badge <%= @event.status == 'active' ? 'badge-primary' : 'badge-accent' %>">
        <%= @event.status == 'active' ? 'Evento Ativo' : 'Em Clímax' %>
      </span>
      <% if @event.is_surprise %>
      <span class="badge badge-secondary">
        Surpresa! 🎉
      </span>
      <% end %>
    </div>
    
    <!-- Event Date -->
    <div class="mb-6">
      <div class="flex items-center gap-2 text-white/50 text-sm uppercase mb-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
        </svg>
        <span>Data do Evento</span>
      </div>
      <div class="text-xl font-bold text-white/90">
        <%= @event.target_date.strftime("%d de %B de %Y às %H:%M") %>
      </div>
    </div>
    
    <!-- Countdown Section -->
    <div class="mb-6 p-4 bg-white/5 rounded-xl border border-white/10">
      <div class="text-sm text-white/60 uppercase mb-3 text-center">Tempo Restante</div>
      <div class="grid grid-cols-4 gap-2">
        <div class="text-center">
          <div class="countdown-digit-sm" id="days">00</div>
          <div class="text-xs text-white/50 mt-1">Dias</div>
        </div>
        <div class="text-center">
          <div class="countdown-digit-sm" id="hours">00</div>
          <div class="text-xs text-white/50 mt-1">Horas</div>
        </div>
        <div class="text-center">
          <div class="countdown-digit-sm" id="minutes">00</div>
          <div class="text-xs text-white/50 mt-1">Min</div>
        </div>
        <div class="text-center">
          <div class="countdown-digit-sm" id="seconds">00</div>
          <div class="text-xs text-white/50 mt-1">Seg</div>
        </div>
      </div>
    </div>
    
    <!-- Quick Stats -->
    <div class="grid grid-cols-2 gap-4 mb-6">
      <div class="stat-card">
        <div class="text-2xl font-bold text-primary">
          <%= @event.messages&.count || 0 %>
        </div>
        <div class="text-xs text-white/60 uppercase">Mensagens</div>
      </div>
      <div class="stat-card">
        <div class="text-2xl font-bold text-secondary">
          <%= @event.participants&.count || 1 %>
        </div>
        <div class="text-xs text-white/60 uppercase">Participantes</div>
      </div>
    </div>
    
    <!-- Action Buttons -->
    <div class="flex gap-4">
      <%= link_to edit_event_path(@event), class: "btn-secondary flex-1 text-center" do %>
        <span class="flex items-center justify-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
          Editar
        </span>
      <% end %>
      <%= button_to @event, method: :delete, 
        class: "btn-secondary flex-1 text-accent hover:text-accent",
        data: { confirm: "Tem certeza que deseja excluir este evento?" } do %>
        <span class="flex items-center justify-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
          </svg>
          Excluir
        </span>
      <% end %>
    </div>
  </div>
  
  <!-- Quick Actions -->
  <div class="grid grid-cols-2 gap-4 animate-fade-in" style="animation-delay: 200ms">
    <%= link_to games_path, class: "glass-card p-4 text-center hover:border-primary/50 transition-all duration-300 transform hover:-translate-y-1" do %>
      <div class="text-3xl mb-2">🎮</div>
      <div class="font-bold text-white/90">Jogos</div>
      <div class="text-xs text-white/60">Ganhe coins</div>
    <% end %>
    
    <%= link_to event_rankings_path(@event), class: "glass-card p-4 text-center hover:border-primary/50 transition-all duration-300 transform hover:-translate-y-1" do %>
      <div class="text-3xl mb-2">🏆</div>
      <div class="font-bold text-white/90">Ranking</div>
      <div class="text-xs text-white/60">Confira sua posição</div>
    <% end %>
  </div>
</div>

<script>
  // Event-specific countdown
  function updateEventCountdown() {
    const targetDate = new Date('<%= @event.target_date.iso8601 %>').getTime();
    const now = new Date().getTime();
    const difference = targetDate - now;

    if (difference > 0) {
      const days = Math.floor(difference / (1000 * 60 * 60 * 24));
      const hours = Math.floor((difference % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((difference % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((difference % (1000 * 60)) / 1000);

      const daysEl = document.getElementById('days');
      const hoursEl = document.getElementById('hours');
      const minutesEl = document.getElementById('minutes');
      const secondsEl = document.getElementById('seconds');

      if (daysEl) daysEl.textContent = String(days).padStart(2, '0');
      if (hoursEl) hoursEl.textContent = String(hours).padStart(2, '0');
      if (minutesEl) minutesEl.textContent = String(minutes).padStart(2, '0');
      if (secondsEl) secondsEl.textContent = String(seconds).padStart(2, '0');
    }
  }

  updateEventCountdown();
  setInterval(updateEventCountdown, 1000);
</script>
