<div class="container-mobile py-8 relative z-10">
  <!-- Page Header -->
  <div class="animate-fade-in mb-8">
    <div class="flex items-center gap-3 mb-2">
      <% if @event %>
        <%= link_to event_path(@event), class: "text-white/40 hover:text-white transition-colors" do %>
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
        <% end %>
      <% end %>
      <h1 class="text-3xl md:text-4xl font-bold bg-gradient-to-r from-amber-400 via-orange-400 to-red-400 bg-clip-text text-transparent">
        Ranking
      </h1>
    </div>
    <p class="text-white/60 text-sm">
      <% if @event %>
        Quem é o rei da festa: <%= @event.name %>?
      <% else %>
        Os maiores festeiros da plataforma!
      <% end %>
    </p>
  </div>
  
  <% if @top_3.any? %>
    <!-- Featured Top 3 with podium -->
    <div class="glass-card p-6 mb-8 animate-fade-in">
      <h2 class="text-xl font-bold text-center mb-6 text-white/90">Top 3 Jogadores</h2>
      
      <!-- Podium -->
      <div class="flex items-end justify-center gap-4 mb-8">
        <!-- 2nd Place -->
        <% if @top_3[1] %>
          <div class="flex-1 max-w-xs">
            <div class="relative">
              <div class="absolute -top-12 left-1/2 transform -translate-x-1/2 text-4xl animate-float">🥈</div>
              <div class="bg-gradient-to-b from-slate-400/20 to-slate-600/20 rounded-t-xl p-4 text-center h-32 flex flex-col items-center justify-end">
                <div class="text-2xl mb-2">👤</div>
                <div class="text-sm font-bold text-white/90 truncate w-full"><%= @top_3[1].user.name %></div>
                <div class="text-xs text-secondary font-semibold"><%= number_with_delimiter(@top_3[1].total_score) %> pts</div>
              </div>
            </div>
          </div>
        <% end %>
        
        <!-- 1st Place -->
        <div class="flex-1 max-w-xs">
          <div class="relative">
            <div class="absolute -top-14 left-1/2 transform -translate-x-1/2 text-5xl animate-float">👑</div>
            <div class="bg-gradient-to-b from-yellow-400/20 to-amber-600/20 rounded-t-xl p-4 text-center h-40 flex flex-col items-center justify-end border-t-2 border-yellow-400/30">
              <div class="text-3xl mb-2">🎮</div>
              <div class="text-lg font-bold text-gradient mb-1 truncate w-full"><%= @top_3[0].user.name %></div>
              <div class="text-sm text-secondary font-semibold"><%= number_with_delimiter(@top_3[0].total_score) %> pts</div>
            </div>
          </div>
        </div>
        
        <!-- 3rd Place -->
        <% if @top_3[2] %>
          <div class="flex-1 max-w-xs">
            <div class="relative">
              <div class="absolute -top-12 left-1/2 transform -translate-x-1/2 text-4xl animate-float">🥉</div>
              <div class="bg-gradient-to-b from-orange-400/20 to-orange-600/20 rounded-t-xl p-4 text-center h-24 flex flex-col items-center justify-end">
                <div class="text-2xl mb-2">👤</div>
                <div class="text-sm font-bold text-white/90 truncate w-full"><%= @top_3[2].user.name %></div>
                <div class="text-xs text-secondary font-semibold"><%= number_with_delimiter(@top_3[2].total_score) %> pts</div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Full Leaderboard -->
    <div class="glass-card p-6 animate-fade-in" style="animation-delay: 200ms">
      <h3 class="text-lg font-bold mb-4 text-white/90">Classificação Completa</h3>
      
      <div class="space-y-3">
        <% @rankings.each_with_index do |ranking, index| %>
          <% 
            bg_class = case index
                       when 0 then "bg-gradient-to-r from-yellow-500/10 to-amber-500/10 border border-yellow-500/20"
                       when 1 then "bg-gradient-to-r from-slate-500/10 to-gray-500/10 border border-slate-500/20"
                       when 2 then "bg-gradient-to-r from-orange-500/10 to-amber-500/10 border border-orange-500/20"
                       else "hover:bg-white/5 border border-transparent"
                       end
            text_class = index < 3 ? "text-white/90" : "text-white/70"
            rank_bg = case index
                      when 0 then "from-yellow-400 to-amber-500"
                      when 1 then "from-slate-400 to-gray-500"
                      when 2 then "from-orange-400 to-amber-600"
                      else "bg-white/10"
                      end
          %>
          
          <div class="flex items-center gap-4 p-3 rounded-xl transition-colors <%= bg_class %>">
            <span class="flex-shrink-0 w-8 h-8 <%= index < 3 ? "bg-gradient-to-br" : "" %> <%= rank_bg %> rounded-full flex items-center justify-center font-bold <%= index < 3 ? "text-white" : "text-white/60" %>">
              <%= index + 1 %>
            </span>
            <div class="flex-1">
              <div class="font-bold <%= text_class %>"><%= ranking.user.name %></div>
              <div class="text-xs text-white/60">Streak: <%= ranking.streak_days %> dias</div>
            </div>
            <div class="text-right">
              <div class="font-bold text-secondary"><%= number_with_delimiter(ranking.total_score) %></div>
              <div class="text-xs text-white/60">pontos</div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="glass-card p-12 text-center animate-fade-in">
      <div class="text-6xl mb-4">🏆</div>
      <h2 class="text-xl font-bold text-white mb-2">Ranking Vazio</h2>
      <p class="text-white/60 mb-6">Ninguém jogou ainda. Seja o primeiro!</p>
      <%= link_to games_path, class: "btn-primary inline-flex items-center gap-2" do %>
        <span>Ir para Jogos</span>
      <% end %>
    </div>
  <% end %>
  
  <% if @current_user_ranking %>
    <!-- Your Stats Card -->
    <div class="glass-card p-6 mt-6 animate-fade-in" style="animation-delay: 400ms">
      <h3 class="text-lg font-bold mb-4 text-white/90">Seu Progresso</h3>
      
      <div class="grid grid-cols-2 gap-4">
        <div class="stat-card">
          <div class="text-2xl font-bold text-primary"><%= number_with_delimiter(@current_user_ranking.total_score) %></div>
          <div class="text-xs text-white/60 uppercase">Pontos Totais</div>
        </div>
        <div class="stat-card">
          <div class="text-2xl font-bold text-secondary"><%= @current_user_ranking.coins %> 💰</div>
          <div class="text-xs text-white/60 uppercase">Coins</div>
        </div>
      </div>
      
      <div class="mt-4 text-center">
        <p class="text-sm text-white/70">Você está na <span class="font-bold text-primary"><%= @current_user_ranking.rank_position %>ª</span> posição!</p>
      </div>
    </div>
  <% end %>
</div>
