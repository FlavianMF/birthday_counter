<div class="container-mobile py-8 relative z-10" data-controller="game" 
     data-game-fiction-value="<%= @game_data[:fiction] %>"
     data-game-event-id-value="<%= @event.id %>">
  
  <!-- Page Header -->
  <div class="animate-fade-in mb-8 flex items-center justify-between">
    <div>
      <%= link_to event_path(@event), class: "text-white/40 hover:text-white transition-colors flex items-center gap-2 mb-2" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        <span>Voltar</span>
      <% end %>
      <h1 class="text-3xl md:text-4xl font-bold bg-gradient-to-r from-fuchsia-400 to-pink-400 bg-clip-text text-transparent">
        Fact or Fiction
      </h1>
    </div>
    
    <div class="text-right">
      <div class="text-xs text-white/50 uppercase font-bold tracking-wider">Pontos</div>
      <div class="text-2xl font-bold text-secondary animate-pulse-soft" data-game-target="score">0</div>
    </div>
  </div>

  <!-- Game Container -->
  <div class="glass-card p-6 animate-scale-in relative overflow-hidden">
    <!-- Progress Bar -->
    <div class="absolute top-0 left-0 w-full h-1 bg-white/5">
      <div class="h-full bg-gradient-to-r from-fuchsia-500 to-pink-500 transition-all duration-500" 
           data-game-target="progressBar" style="width: 0%"></div>
    </div>

    <!-- Instructions -->
    <div class="text-center mb-8" data-game-target="instructions">
      <div class="text-5xl mb-4 animate-float">❓</div>
      <h2 class="text-xl font-bold text-white mb-2">Qual dessas é a mentira?</h2>
      <p class="text-white/60 text-sm">O aniversariante contou 3 histórias, mas uma delas foi criada pela nossa IA. Consegue descobrir qual?</p>
    </div>

    <!-- Statements List -->
    <div class="space-y-4" data-game-target="statements">
      <% @statements.each do |statement| %>
        <%= content_tag :button, 
            class: "w-full text-left p-4 rounded-xl border border-white/10 bg-white/5 hover:bg-white/10 hover:border-fuchsia-500/50 transition-all duration-300 group cursor-pointer relative z-50",
            data: { 
              action: "click->game#guess",
              statement: statement
            } do %>
          <div class="flex items-start gap-3 pointer-events-none">
            <span class="flex-shrink-0 w-6 h-6 rounded-full border border-white/20 flex items-center justify-center text-xs text-white/40 group-hover:border-fuchsia-500/50 group-hover:text-fuchsia-500 transition-colors">
              ?
            </span>
            <p class="text-white/80 group-hover:text-white transition-colors"><%= statement %></p>
          </div>
        <% end %>
      <% end %>
    </div>

    <!-- Result Feedback (Hidden Initially) -->
    <div class="hidden text-center py-8 animate-fade-in" data-game-target="feedback">
      <div class="text-6xl mb-4" data-game-target="resultIcon">🎉</div>
      <h2 class="text-3xl font-bold text-white mb-2" data-game-target="resultTitle">Acertou!</h2>
      <p class="text-white/60 mb-8" data-game-target="resultMessage">Você é um expert no host!</p>
      
      <div class="grid grid-cols-2 gap-4 mb-8">
        <div class="stat-card">
          <div class="text-2xl font-bold text-primary" data-game-target="earnedPoints">+500</div>
          <div class="text-xs text-white/60">Pontos</div>
        </div>
        <div class="stat-card">
          <div class="text-2xl font-bold text-secondary" data-game-target="earnedCoins">+50 💰</div>
          <div class="text-xs text-white/60">Coins</div>
        </div>
      </div>

      <div class="flex gap-4">
        <%= link_to "Novo Jogo", fact_or_fiction_event_games_path(@event), class: "btn-primary flex-1" %>
        <%= link_to "Ranking", event_rankings_path(@event), class: "btn-secondary flex-1" %>
      </div>
    </div>
  </div>

  <!-- Footer Tips -->
  <div class="mt-8 text-center animate-fade-in" style="animation-delay: 400ms">
    <p class="text-white/40 text-xs italic">Dica: A IA costuma ser criativa demais em detalhes específicos.</p>
  </div>
</div>
