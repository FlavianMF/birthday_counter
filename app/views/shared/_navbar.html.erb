<!-- Top Navbar - Visible on Desktop, Hidden on Mobile -->
<nav class="hidden md:block fixed top-0 left-0 right-0 z-50">
  <div class="glass-card mx-4 mt-4 p-4 flex items-center justify-between backdrop-blur-xl">
    <!-- Logo -->
    <div class="flex items-center gap-3">
      <div class="relative w-10 h-10 bg-gradient-primary rounded-xl flex items-center justify-center transform hover:scale-110 transition-transform duration-300">
        <div class="absolute inset-0 bg-gradient-to-r from-violet-600 to-fuchsia-600 rounded-xl blur opacity-50"></div>
        <span class="relative text-xl">🎂</span>
      </div>
      <h1 class="text-xl font-bold text-gradient">Birthday Counter</h1>
    </div>

    <!-- Desktop Navigation -->
    <div class="flex items-center gap-4">
      <% if logged_in? %>
      <%= link_to events_path, class: "text-white/70 hover:text-white transition-colors flex items-center gap-2 group" do %>
        <svg class="w-5 h-5 transform group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
        </svg>
        <span class="<%= current_page?(events_path) ? 'text-primary' : '' %>">Eventos</span>
      <% end %>
      
      <%= link_to games_path, class: "text-white/70 hover:text-white transition-colors flex items-center gap-2 group" do %>
        <svg class="w-5 h-5 transform group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <span class="<%= current_page?(games_path) ? 'text-primary' : '' %>">Jogos</span>
      <% end %>
      
      <%= link_to rankings_path, class: "text-white/70 hover:text-white transition-colors flex items-center gap-2 group" do %>
        <svg class="w-5 h-5 transform group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
        </svg>
        <span class="<%= current_page?(rankings_path) ? 'text-primary' : '' %>">Ranking</span>
      <% end %>

      <!-- User section -->
      <div class="flex items-center gap-3 pl-4 border-l border-white/10">
        <!-- Coins display -->
        <div class="flex items-center gap-2 px-3 py-1.5 bg-secondary/20 rounded-full border border-secondary/30">
          <span class="text-sm">💰</span>
          <span class="text-sm font-bold text-secondary"><%= current_user_coins %></span>
        </div>
        
        <!-- Profile link -->
        <%= link_to profile_path, class: "flex items-center gap-2 hover:opacity-80 transition-opacity" do %>
          <div class="w-8 h-8 bg-gradient-primary rounded-full flex items-center justify-center">
            <span class="text-sm">👤</span>
          </div>
        <% end %>
        
        <%= button_to logout_path, method: :delete, class: "btn-secondary text-sm" do %>
          Sair
        <% end %>
      </div>
      <% else %>
      <%= link_to "Entrar", login_path, class: "btn-secondary" %>
      <%= link_to "Criar Conta", register_path, class: "btn-primary" %>
      <% end %>
    </div>
  </div>
</nav>
