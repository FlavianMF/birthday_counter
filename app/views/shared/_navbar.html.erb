<!-- Top Navbar - Visible on Desktop & Mobile -->
<nav class="fixed top-0 left-0 right-0 z-50">
  <div class="glass-card mx-4 mt-4 p-3 md:p-4 flex items-center justify-between backdrop-blur-xl">
    <!-- Logo as Link to Home -->
    <%= link_to root_path, class: "flex items-center gap-2 md:gap-3 hover:opacity-80 transition-all duration-300 group" do %>
      <div class="relative w-8 h-8 md:w-10 md:h-10 bg-gradient-primary rounded-xl flex items-center justify-center transform group-hover:scale-110 transition-transform duration-300">
        <div class="absolute inset-0 bg-gradient-to-r from-violet-600 to-fuchsia-600 rounded-xl blur opacity-50"></div>
        <span class="relative text-lg md:text-xl">🎂</span>
      </div>
      <h1 class="text-lg md:text-xl font-bold text-gradient">Birthday Counter</h1>
    <% end %>

    <!-- Navigation -->
    <div class="flex items-center gap-2 md:gap-4">
      <!-- Desktop Links -->
      <div class="hidden md:flex items-center gap-4 mr-4 pr-4 border-r border-white/10">
        <%= link_to root_path, class: "text-white/70 hover:text-white transition-colors flex items-center gap-2 group" do %>
          <svg class="w-5 h-5 transform group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
          </svg>
          <span class="<%= current_page?(root_path) ? 'text-primary' : '' %>">Início</span>
        <% end %>

        <% if logged_in? %>
          <%= link_to events_path, class: "text-white/70 hover:text-white transition-colors flex items-center gap-2 group" do %>
            <svg class="w-5 h-5 transform group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
            <span class="<%= current_page?(events_path) ? 'text-primary' : '' %>">Eventos</span>
          <% end %>
          
          <%= link_to games_path, class: "text-white/70 hover:text-white transition-colors flex items-center gap-2 group" do %>
            <svg class="w-5 h-5 transform group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span class="<%= current_page?(games_path) ? 'text-primary' : '' %>">Jogos</span>
          <% end %>
        <% end %>
      </div>

      <!-- User Actions -->
      <div class="flex items-center gap-3" 
           data-controller="user-stats" 
           data-user-stats-user-id-value="<%= current_user&.id %>">
        <% if logged_in? %>
          <!-- Coins - Hidden on small mobile -->
          <div class="hidden sm:flex items-center gap-2 px-3 py-1.5 bg-secondary/20 rounded-full border border-secondary/30">
            <span class="text-sm">💰</span>
            <span class="text-sm font-bold text-secondary" data-user-stats-target="coins"><%= current_user_coins %></span>
          </div>
          
          <!-- Profile Link -->
          <%= link_to profile_path, class: "w-8 h-8 md:w-10 md:h-10 bg-gradient-primary rounded-full flex items-center justify-center hover:opacity-80 transition-opacity border border-white/10" do %>
            <span class="text-sm md:text-base">👤</span>
          <% end %>
          
          <!-- Logout Button -->
          <%= button_to logout_path, method: :delete, class: "hidden md:block btn-secondary text-sm py-2 px-4" do %>
            Sair
          <% end %>
        <% else %>
          <%= link_to "Entrar", login_path, class: "text-white/70 hover:text-white text-sm font-medium transition-colors" %>
          <%= link_to "Criar Conta", register_path, class: "btn-primary text-sm py-2 px-4" %>
        <% end %>
      </div>
    </div>
  </div>
</nav>

