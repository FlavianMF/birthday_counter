<% if notice %>
  <div class="fixed top-4 left-1/2 transform -translate-x-1/2 z-50 w-full max-w-md mx-4 md:mx-auto">
    <div class="glass-card bg-success/20 border-success/30 text-success p-4 rounded-xl flex items-center gap-3 animate-slide-up">
      <svg class="w-6 h-6 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      <p class="text-sm font-medium"><%= notice %></p>
      <button data-action="click->flash#hide" class="ml-auto">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>
<% end %>

<% if alert %>
  <div class="fixed top-4 left-1/2 transform -translate-x-1/2 z-50 w-full max-w-md mx-4 md:mx-auto">
    <div class="glass-card bg-accent/20 border-accent/30 text-white p-4 rounded-xl flex items-center gap-3 animate-slide-up">
      <svg class="w-6 h-6 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      <p class="text-sm font-medium"><%= alert %></p>
      <button data-action="click->flash#hide" class="ml-auto">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>
<% end %>
