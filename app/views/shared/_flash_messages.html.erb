<% if flash.any? %>
  <div class="fixed top-4 right-4 z-50 space-y-2 max-w-md">
    <% flash.each do |key, value| %>
      <div class="
        <%= key == 'notice' ? 'bg-gradient-to-r from-emerald-500 to-teal-500' : 'bg-gradient-to-r from-red-500 to-rose-500' %>
        text-white px-6 py-4 rounded-xl shadow-2xl animate-fade-in
        flex items-center gap-3 backdrop-blur-sm
        <%= key == 'notice' ? 'bg-opacity-90' : 'bg-opacity-90' %>
      ">
        <% if key == 'notice' %>
          <svg class="w-6 h-6 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        <% else %>
          <svg class="w-6 h-6 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        <% end %>
        <span class="font-medium"><%= value %></span>
        <button onclick="this.parentElement.remove()" class="ml-auto hover:opacity-75 transition-opacity">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    <% end %>
  </div>
<% end %>
